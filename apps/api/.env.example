# Porta del backend Odys
PORT=3000
# Origine consentita per il frontend Angular in sviluppo
CORS_ORIGIN=http://localhost:4200

# --- Supabase (account, login e archivio dei dati) ---------------------------
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chiave segreta "service_role": serve solo per eliminare un account e per la
# cache condivisa del geocoding. Non va MAI messa nel frontend o condivisa.
SUPABASE_SERVICE_ROLE_KEY=
# Database (serve solo per `npm run db:migrate`): Supabase → Connect → Direct →
# Session pooler → URI. La password va nella riga sotto, così com'è.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# --- Provider opzionali: senza chiavi l'app usa i fallback locali dichiarati ---
GEOAPIFY_KEY=
GRAPHHOPPER_KEY=
MAPTILER_KEY=

# --- Suggerimenti di località (OpenStreetMap) ----------------------------------
# Servizi gratuiti OpenStreetMap usati quando mancano le chiavi sopra:
#   - Photon per suggerimenti e posizioni (senza GEOAPIFY_KEY);
#   - OSRM su routing.openstreetmap.de per i percorsi (senza GRAPHHOPPER_KEY);
#   - tile di tile.openstreetmap.org per la mappa (nel browser).
# Sono pensati per un uso moderato: in produzione con molto traffico servono
# istanze proprie (indirizzi qui sotto) o le chiavi dei provider.
PHOTON_URL=
OSRM_URL=
OSM_USER_AGENT=

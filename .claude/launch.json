{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4200
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@odys/api"
      ],
      "port": 3000
    },
    {
      "name": "prod-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-prod.mjs"
      ],
      "port": 4300
    }
  ]
}